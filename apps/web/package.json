{
  "name": "@forksafe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "test:e2e": "playwright test -c ../../tests/browser/playwright.config.ts"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@forksafe/contracts": "workspace:*",
    "convex": "1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "~0.186.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
