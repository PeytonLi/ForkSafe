# Copy to .env.local (ignored). Never commit real values. `pnpm doctor` reports which names are missing.
APP_MODE=local
WEB_PORT=5173

# Convex (hosted dev deployment; CONVEX_MODE=local switches to a self-hosted dev backend)
CONVEX_MODE=cloud
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_ADMIN_KEY=
CONVEX_DEPLOY_KEY=

# Daytona
DAYTONA_MODE=cloud
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_RUNNER_SNAPSHOT=
DAYTONA_EXECUTION_SNAPSHOT=
DAYTONA_MAX_ACTIVE_SANDBOXES=5
DAYTONA_EXECUTION_CONCURRENCY=3

# Trusted runner / artifacts
RUNNER_MODE=local
ARTIFACT_MODE=local
ARTIFACT_ROOT=./var/artifacts
RUNNER_CALLBACK_SECRET=
INTEGRATION_SHARED_SECRET=

# Simulator / evaluator (Python MuJoCo services; run inside Daytona execution sandboxes in cloud mode)
SIMULATOR_MODE=cloud
SIMULATOR_URL=http://127.0.0.1:8000
EVALUATOR_URL=http://127.0.0.1:8001

# SpacetimeDB (Maincloud; SPACETIMEDB_MODE=local switches to a local CLI instance)
SPACETIMEDB_MODE=cloud
SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=forksafe

# Factory
FACTORY_MODE=cloud
FACTORY_API_KEY=
FACTORY_MODEL=

# Elastic
ELASTIC_MODE=cloud
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_AGENT_BUILDER_MODE=cloud
KIBANA_URL=
KIBANA_API_KEY=

# Atlassian
ATLASSIAN_MODE=cloud
ATLASSIAN_SITE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_PROJECT_KEY=
FORGE_APP_ID=

# Limits
MAX_ENVIRONMENTS=10
DEFAULT_ENVIRONMENTS=3
MAX_ACTIVE_MODEL_CALLS=4
